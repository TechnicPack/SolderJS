{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "includes": [
      "**",
      "!**/.claude/**",
      "!.github/dependabot.yml",
      "!**/.idea/**",
      "!**/.pnpm-store/**",
      "!**/.vscode/**",
      "!**/docs/**",
      "!**/todo.md",
      "!**/package-lock.json",
      "!**/package.json",
      "!**/pnpm-lock.yaml",
      "!**/renovate.json"
    ]
  },
  "linter": {
    "enabled": true,
    "includes": ["**/*.js", "!**/docs/**"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noShadow": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
